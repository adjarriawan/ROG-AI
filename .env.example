APP_ENV=development

# Passwords are referenced by docker-compose AND by the two URLs below; keep
# them in sync. Use real secrets here - never commit the resulting .env.
POSTGRES_PASSWORD=change-me-postgres
RAG_READONLY_PASSWORD=change-me-readonly

DATABASE_URL=postgresql+psycopg://postgres:change-me-postgres@localhost:5433/agentic_rag
DATABASE_URL_READONLY=postgresql+psycopg://rag_readonly:change-me-readonly@localhost:5433/agentic_rag

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

CORS_ORIGINS=http://localhost:5173

# Agent/RAG tuning. Defaults live in backend/config.py; override here.
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.6
SQL_TIMEOUT_MS=5000
SQL_MAX_ROWS=50
OCR_TIMEOUT_SECONDS=180
AGENT_MAX_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=240
LOG_LEVEL=INFO
